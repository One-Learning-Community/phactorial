{
    "name": "phactorial/recipes",
    "description": "Runs the documentation's recipes as tests.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "phactorial/phactorial": "0.18.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/commonmark",
            "options": {
                "symlink": true,
                "versions": {
                    "phactorial/commonmark": "0.18.x-dev"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "App\\Markdown\\": "laravel/",
            "Phactorial\\Recipes\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "phactorial/commonmark": "@dev",
        "phpunit/phpunit": "^13.4",
        "spatie/laravel-markdown": "^2.8"
    }
}
